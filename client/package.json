{
  "name": "simple-webrtc-client",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript WebRTC client with multi-channel data support, speaking the signaling protocol in docs/DESIGN.md",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "tsx": "4.23.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
