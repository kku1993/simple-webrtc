{
  "name": "@simple-webrtc/client",
  "version": "0.6.0",
  "description": "Zero-dependency TypeScript WebRTC client with media and multi-channel data support, speaking the signaling protocol in docs/DESIGN.md",
  "license": "MIT",
  "type": "module",
  "main": "./client/dist/index.js",
  "types": "./client/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./client/dist/index.d.ts",
      "import": "./client/dist/index.js"
    }
  },
  "files": [
    "client/dist"
  ],
  "scripts": {
    "build": "cd client && npm run build",
    "typecheck": "cd client && npm run typecheck",
    "lint": "cd client && npm run lint",
    "test": "cd client && npm test"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
